{
    "version": 2,
    "framework": "vite",
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/percy-api/:path*",
            "destination": "https://percy.io/api/v1/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}
